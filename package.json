    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "update": "npx --yes eas-cli update --auto",
    "update:preview": "npx --yes eas-cli update --branch preview --message \"Live Tier-1 Update\"",
    "update:prod": "npx --yes eas-cli update --branch production --message \"Live Tier-1 Production Update\"",
    "build:apk": "npx --yes eas-cli build -p android --profile preview",
    "export": "expo export"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
